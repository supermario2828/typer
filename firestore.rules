rules_version = '2';

// Each user can only read and write their OWN runs. Nobody can touch anyone
// else's data. Paste this into Firebase console → Firestore → Rules → Publish.
service cloud.firestore {
  match /databases/{database}/documents {

    // Private per-user run history.
    match /users/{uid}/runs/{runId} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null
                    && request.auth.uid == uid
                    && request.resource.data.wpm is number
                    && request.resource.data.accuracy is number;
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // Named devices, private to each user.
    match /users/{uid}/devices/{deviceId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Global leaderboard: any signed-in user may read; you may only create
    // entries for yourself, and only delete your own.
    match /scores/{scoreId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.wpm is number
                    && request.resource.data.accuracy is number;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }
  }
}
